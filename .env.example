# Server
SERVER_PORT=8080

# 它不参与 datetime 的读写，改它不会重新解释已经存好的时间。
# 数据库的时间语义固定在代码里的 repository.StorageTimezone。
APP_TIMEZONE=Asia/Shanghai

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=memora

# LLM (OpenAI-compatible)
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-xxxxxxxx
LLM_MODEL=deepseek-chat

# 测试库连接串（可选）。不设置时，需要真实 MySQL 的测试会被跳过。
# 库名必须以 _test 结尾：测试会 DROP 并重建它。
# 这里只提供地址和凭据，时间语义由代码统一指定，不需要也不用写 loc。
# MEMORA_TEST_DSN=root:password@tcp(127.0.0.1:3306)/memora_test?charset=utf8mb4&parseTime=true
